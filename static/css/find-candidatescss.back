/* 🌐 CSS: find-candidates.css (Utility-Friendly & Layout-Only) */

*,
*::before,
*::after {
    box-sizing: inherit;
}

html {
    box-sizing: border-box;
}

body {
    color: #171717;
    background-color: #ffffff;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.hidden {
    display: none;
}

.candidate-item {
    display: inline-block;
    max-width: 90%;
    padding: 16px;
    margin: 0 auto 20px auto;
    border: 1px solid #ccc;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.05);
    animation: fadeInUp 0.4s ease forwards;
    opacity: 0;
    transform: translateY(10px);
    overflow: hidden;
    vertical-align: top;
    text-align: left;
}

.candidate-item h3 {
    margin-top: 0;
}

.candidate-item a {
    color: #0066cc;
    text-decoration: none;
}

.candidate-item a:hover {
    text-decoration: underline;
}

.candidate-item a:focus-visible,
button:focus-visible {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
}

#customDialogBackdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

#customDialog {
    background: white;
    padding: 20px;
    border-radius: 8px;
    max-width: 400px;
    width: 90%;
    text-align: center;
}

#customDialog button {
    display: inline-block;
    margin: 5px;
    max-width: 100%;
    white-space: nowrap;
    text-align: center;
    cursor: pointer;
}

#customDialog:focus {
    outline: 2px solid #0066cc;
}

.zip-top-spacer {
    margin-top: 30px;
}

.location-notice {
    background: #f3f3f3;
    padding: 10px;
    margin-bottom: 10px;
    border-left: 4px solid #00aaff;
    font-size: 0.95em;
}

.district-list {
    list-style: none;
    padding: 0;
    margin: 10px 0;
}

.district-list li {
    padding: 4px 0;
    font-weight: bold;
}

@keyframes fadeInUp {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-color-scheme: dark) {
    body {
        color: #ffffff;
        background-color: #171717;
    }

    .candidate-item {
        background-color: #2c2c2c;
        color: #ffffff;
    }
}
